## Implementation Guidelines

### Entity Processing

```javascript
// Process and normalize incoming entity data
function processEntityData(rawEntityData) {
  // Extract primary entities and their attributes
  const extractedEntities = rawEntityData.map(raw => {
    // Determine entity type
    const entityType = determineEntityType(raw);
    
    // Extract and normalize attributes based on schema
    const attributes = extractAttributes(raw, entityType);
    
    // Validate against schema requirements
    validateEntityAttributes(attributes, entityType);
    
    return {
      id: generateEntityId(entityType, attributes),
      entityType,
      ...attributes
    };
  });
  
  // Deduplicate entities
  return deduplicateEntities(extractedEntities);
}
```

### Visualization Configuration

```javascript
// Configure visualization based on data characteristics
function configureVisualization(entities, relationships, analysisResults) {
  // Determine optimal visualization approach based on data
  const visualizationApproach = determineOptimalVisualization(
    entities, 
    relationships,
    analysisResults
  );
  
  // Configure node appearance and behavior
  const nodeConfig = {
    baseSize: calculateBaseNodeSize(entities),
    sizeScaleFactor: determineSizeScaling(entities),
    colorScheme: selectColorScheme(entities),
    iconSet: selectIconSet(entities),
    labelConfig: configureLabelDisplay(entities)
  };
  
  // Configure edge appearance and behavior
  const edgeConfig = {
    baseThickness: calculateBaseEdgeThickness(relationships),
    thicknessScaleFactor: determineThicknessScaling(relationships),
    colorScheme: selectEdgeColorScheme(relationships),
    arrowConfig: configureArrowDisplay(relationships),
    labelConfig: configureEdgeLabelDisplay(relationships)
  };
  
  // Configure interaction behaviors
  const interactionConfig = {
    zoomBehavior: configureZoomBehavior(),
    clickBehavior: configureClickBehavior(),
    hoverBehavior: configureHoverBehavior(),
    filteringOptions: configureFilteringOptions(entities, relationships)
  };
  
  return {
    approach: visualizationApproach,
    nodeConfig,
    edgeConfig,
    interactionConfig,
    animationConfig: configureAnimations(analysisResults),
    layoutConfig: configureLayout(entities, relationships)
  };
}
```

