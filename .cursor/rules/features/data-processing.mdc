## Sample Code for Xata Extraction

```typescript
// Adjust the import according to your Xata SDK version.
// For example, if you installed @xata.io/client:
// import { XataClient } from '@xata.io/client';
import { XataClient } from 'xata/client'; // <-- adjust as required

// Setup logging using the console.
const logger = console;

// Retrieve Xata credentials from environment variables.
const XATA_API_KEY = process.env.XATA_API_KEY;
const XATA_DATABASE = process.env.XATA_DATABASE;

if (!XATA_API_KEY || !XATA_DATABASE) {
  logger.error("Missing XATA_API_KEY or XATA_DATABASE environment variable.");
  throw new Error("XATA API credentials must be set.");
}

// Initialize the Xata client.
// Adjust the initialization if your SDK version requires different parameters.
const xataClient = new XataClient({ apiKey: XATA_API_KEY, database: XATA_DATABASE });

/**
 * Searches for a record in the given table using a fragment of the analysis text.
 *
 * @param analysisText - The output from the AI analysis (e.g., transcript summary)
 * @param tableName - The target table to search records in.
 * @param searchField - The field on which to match the analysis text. Default is "summary".
 * @returns The first matching record if found; otherwise, null.
 */
async function searchRecordForAnalysis(
  analysisText: string,
  tableName: string,
  searchField: string = "summary"
): Promise<any | null> {
  const queryFragment = analysisText.trim().substring(0, 50);
  logger.info(`Searching for records in '${tableName}' with ${searchField} matching: ${queryFragment}`);

  try {
    // The SDK might expose a `records.search` method.
    // Adjust the call as needed based on SDK documentation.
    const response = await xataClient.records.search({
      table: tableName,
      query: {
        query: `${searchField}:*${queryFragment}*`
      }
    });
    logger.debug(`Search response: ${JSON.stringify(response)}`);

    // Assume the response contains a list of records in the "records" property.
    const records = response.records || [];
    if (records.length > 0) {
      logger.info(`Found ${records.length} record(s).`);
      return records[0]; // Return the first matching record.
    } else {
      logger.info("No matching records found.");
      return null;
    }
  } catch (err: any) {
    logger.error(`Error while searching records: ${err}`);
    return null;
  }
}

/**
 * Parses the transcript summary output and extracts entities from specific sections.
 *
 * @param analysisText - The transcript summary with AI analysis.
 * @returns An object with keys "topics", "personnel", "events", "organizations".
 */
function extractEntitiesFromAnalysis(analysisText: string): { topics: string[]; personnel: string[]; events: string[]; organizations: string[] } {
  const entities = {
    topics: [] as string[],
    personnel: [] as string[],
    events: [] as string[],
    organizations: [] as string[]
  };

  const lines = analysisText.split(/\r?\n/);
  let currentSection: keyof typeof entities | null = null;

  const sectionHeaders: { [key: string]: keyof typeof entities } = {
    "Topics Covered:": "topics",
    "Personnel Mentioned:": "personnel",
    "Events Referenced:": "events",
    "Organizations Involved:": "organizations"
  };

  for (const line of lines) {
    const stripped = line.trim();

    // Check for section header markers.
    let headerFound = false;
    for (const [header, key] of Object.entries(sectionHeaders)) {
      if (stripped.startsWith(header)) {
        currentSection = key;
        headerFound = true;
        break;
      }
    }
    if (headerFound) {
      // Skip processing the header line itself.
      continue;
    }

    // If a section is active, process bullet points or numbered items.
    if (currentSection && stripped) {
      // Check if the line begins with a dash or a digit.
      if (/^[-\d]/.test(stripped)) {
        // Remove common bullet formatting (dashes, digits, periods, and whitespace).
        const entity = stripped.replace(/^[-\d\.]+\s*/, "");
        if (entity) {
          entities[currentSection].push(entity);
        }
      }
    }
  }

  return entities;
}

/**
 * Searches for each extracted entity in its respective Xata table.
 *
 * @param analysisText - The transcript summary with AI analysis.
 * @param tableMapping - An object mapping entity categories (e.g., "topics")
 *                        to Xata table names.
 * @returns An object with the same keys as tableMapping. Each key maps to a list of search results.
 */
async function searchEntitiesFromAnalysis(
  analysisText: string,
  tableMapping: { [category: string]: string }
): Promise<{ [category: string]: any[] }> {
  const searchResults: { [category: string]: any[] } = {};
  const extracted = extractEntitiesFromAnalysis(analysisText);

  for (const [category, table] of Object.entries(tableMapping)) {
    const results: any[] = [];
    // For each extracted entity for the given category, perform a search.
    const entities = extracted[category as keyof typeof extracted] || [];
    for (const entity of entities) {
      const result = await searchRecordForAnalysis(entity, table);
      if (result) {
        results.push(result);
      }
    }
    searchResults[category] = results;
  }

  return searchResults;
}

