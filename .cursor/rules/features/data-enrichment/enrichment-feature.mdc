## Table Processing Logic for Xata Schema

Let's add some specific logic to handle different types of tables in the Xata schema, addressing table-specific enrichment strategies:

```typescript
// src/enrichers/tableStrategies.ts
import { EnrichRecord, EnrichField } from '../types/common';

// Define strategies for specific tables
export const tableStrategies: Record<string, (record: EnrichRecord) => Promise<string>> = {
  // Strategy for topics table
  topics: async (record) => {
    const title = record.fields.find(f => f.name === 'title')?.value;
    const name = record.fields.find(f => f.name === 'name')?.value;
    
    if (title || name) {
      return `detailed information about ${title || name} topic`;
    }
    return 'general information about this topic';
  },

  // Strategy for personnel table
  personnel: async (record) => {
    const name = record.fields.find(f => f.name === 'name')?.value;
    const role = record.fields.find(f => f.name === 'role')?.value;
    
    if (name) {
      return `${name} ${role ? `${role}` : ''} biography background professional experience`;
    }
    return 'personnel biographical information';
  },

  // Strategy for events table
  events: async (record) => {
    const title = record.fields.find(f => f.name === 'title')?.value;
    const date = record.fields.find(f => f.name === 'date')?.value;
    const location = record.fields.find(f => f.name === 'location')?.value;
    
    let query = title ? `${title}` : 'event';
    if (date) query += ` ${date}`;
    if (location) query += ` ${location}`;
    return `${query} full details information`;
  },

  // Strategy for organizations table
  organizations: async (record) => {
    const name = record.fields.find(f => f.name === 'name')?.value;
    const specialization = record.fields.find(f => f.name === 'specialization')?.value;
    
    if (name) {
      return `${name} ${specialization ? `${specialization}` : ''} organization company information history background`;
    }
    return 'organization information profile';
  },

  // Strategy for sightings table
  sightings: async (record) => {
    const date = record.fields.find(f => f.name === 'date')?.value;
    const city = record.fields.find(f => f.name === 'city')?.value;
    const state = record.fields.find(f => f.name === 'state')?.value;
    const shape = record.fields.find(f => f.name === 'shape')?.value;
    
    let query = 'UFO sighting';
    if (date) query += ` ${date}`;
    if (city && state) query += ` in ${city}, ${state}`;
    else if (city) query += ` in ${city}`;
    else if (state) query += ` in ${state}`;
    if (shape) query += ` ${shape} shaped`;
    
    return query;
  },

  // Add strategies for other tables as needed
  artifacts: async (record) => {
    const name = record.fields.find(f => f.name === 'name')?.value;
    const origin = record.fields.find(f => f.name === 'origin')?.value;
    
    if (name) {
      return `${name} ${origin ? `from ${origin}` : ''} artifact historical information`;
    }
    return 'artifact historical information';
  },
};

export function getTableStrategy(tableName: string) {
  return tableStrategies[tableName] || null;
}
```

Now let's update the `generateSearchQuery` method in the BaseEnricher to use these table-specific strategies when available:

```typescript
// Update in src/enrichers/baseEnricher.ts
import { getTableStrategy } from './tableStrategies';

// Inside BaseEnricher class
async generateSearchQuery(record: EnrichRecord, missingFields: EnrichField[]): Promise<string> {
  // Check if we have a specific strategy for this table
  const tableStrategy = record.tableName ? getTableStrategy(record.tableName) : null;
  
  if (tableStrategy) {
    // Use the table-specific strategy to generate the base query
    const baseQuery = await tableStrategy(record);
    
    // Get non-null fields for context
    const knownFields = record.fields
      .filter(field => field.value !== null && field.value !== undefined && field.value !== '')
      .map(field => `${field.name}: ${field.value}`)
      .join(', ');

    const missingFieldNames = missingFields.map(field => field.name).join(', ');

    // Create a prompt for OpenAI to refine the base query
    const prompt = `
      I have a record from the "${record.tableName}" table with the following information:
      ${knownFields || 'No known information'}
      
      I need to find information to fill in the following missing fields:
      ${missingFieldNames}
      
      I have a base search query: "${baseQuery}"
      
      Refine this query to better target the missing fields. Focus on finding specific information for ${missingFieldNames}.
      Return only the refined search query, no explanations.
    `;

    const completion = await this.openai.chat.completions.create({
      model: "gpt-3.5-turbo",
      messages: [
        { role: "system", content: "You are a search query optimization assistant. Refine search queries to find specific information." },
        { role: "user", content: prompt }
      ],
      temperature: 0.3,
    });

    return completion.choices[0].message.content || baseQuery;
  } else {
    // Fall back to the generic approach if no table-specific strategy exists
    const knownFields = record.fields
      .filter(field => field.value !== null && field.value !== undefined && field.value !== '')
      .map(field => `${field.name}: ${field.value}`)
      .join(', ');

    const missingFieldNames = missingFields.map(field => field.name).join(', ');

    const prompt = `
      I have a record${record.tableName ? ` from the "${record.tableName}" table` : ''} with the following information:
      ${knownFields || 'No known information'}
      
      I need to find information to fill in the following missing fields:
      ${missingFieldNames}
      
      Generate a search query that will help me find this information.
      The search query should:
      1. Include key identifying information from the known fields
      2. Be specific enough to find the missing information
      3. Focus on the most relevant known attributes
      4. Be formatted for web search (not as a question)
    `;

    const completion = await this.openai.chat.completions.create({
      model: "gpt-3.5-turbo",
      messages: [
        { role: "system", content: "You are a helpful assistant that generates search queries to find missing information." },
        { role: "user", content: prompt }
      ],
      temperature: 0.5,
    });

    return completion.choices[0].message.content || "";
  }
}
```

