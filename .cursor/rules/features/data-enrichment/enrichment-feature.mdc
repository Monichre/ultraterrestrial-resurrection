## Abstract Enricher Interface

```typescript
// src/enrichers/baseEnricher.ts
import { EnrichmentConfig, EnrichData, EnrichmentResult, EnrichField, EnrichRecord } from '../types/common';
import { tavily } from '@tavily/core';
import OpenAI from 'openai';

export abstract class BaseEnricher {
  protected tavily;
  protected openai;
  protected config: EnrichmentConfig;
  
  constructor(config: EnrichmentConfig) {
    this.config = config;
    this.tavily = tavily({ apiKey: config.tavilyApiKey });
    this.openai = new OpenAI({ apiKey: config.openaiApiKey });
  }

  abstract loadData(source: any): Promise<EnrichData>;
  abstract saveData(data: EnrichData, destination: any): Promise<void>;
  
  async generateSearchQuery(record: EnrichRecord, missingFields: EnrichField[]): Promise<string> {
    // Get non-null fields from the record to use as context
    const knownFields = record.fields
      .filter(field => field.value !== null && field.value !== undefined && field.value !== '')
      .map(field => `${field.name}: ${field.value}`)
      .join(', ');

    const missingFieldNames = missingFields.map(field => field.name).join(', ');

    // Create a prompt for OpenAI to generate a search query
    const prompt = `
      I have a record${record.tableName ? ` from the "${record.tableName}" table` : ''} with the following information:
      ${knownFields || 'No known information'}
      
      I need to find information to fill in the following missing fields:
      ${missingFieldNames}
      
      Generate a search query that will help me find this information.
      The search query should:
      1. Include key identifying information from the known fields
      2. Be specific enough to find the missing information
      3. Focus on the most relevant known attributes
      4. Be formatted for web search (not as a question)
    `;

    const completion = await this.openai.chat.completions.create({
      model: "gpt-3.5-turbo",
      messages: [
        { role: "system", content: "You are a helpful assistant that generates search queries to find missing information." },
        { role: "user", content: prompt }
      ],
      temperature: 0.5,
    });

    return completion.choices[0].message.content || "";
  }

  async extractDataFromSearchResults(
    searchResults: any[], 
    record: EnrichRecord, 
    missingFields: EnrichField[]
  ): Promise<Record<string, any>> {
    // Extract content from search results
    const context = searchResults.map(result => result.content).join('\n\n');

    // If no relevant context was found, return empty object
    if (!context.trim()) {
      return {};
    }

    // Create examples from existing data for the model to learn from
    const examples = record.fields
      .filter(field => field.value !== null && field.value !== undefined && field.value !== '')
      .map(field => `${field.name}: ${field.value}`)
      .join('\n');

    const missingFieldNames = missingFields.map(field => field.name);

    // Use OpenAI to extract relevant information from the search results
    const extractPrompt = `
      I have the following information about ${record.tableName ? `a "${record.tableName}" record` : 'an entity'}:
      ${examples || 'No current information'}
      
      I need to fill in the following missing fields:
      ${missingFieldNames.join(', ')}
      
      Here is the context from my search:
      ${context}
      
      Based on this context, please provide values for the missing fields in JSON format like:
      {
        ${missingFieldNames.map(name => `"${name}": "value"`).join(',\n')}
      }
      
      If you cannot find a value for a field, leave it as null.
      Consider the appropriate data type for each field.
    `;

    const completion = await this.openai.chat.completions.create({
      model: "gpt-3.5-turbo",
      messages: [
        { 
          role: "system", 
          content: "You are a helpful assistant that extracts information from search results. You provide only the requested information in the specified format." 
        },
        { role: "user", content: extractPrompt }
      ],
      temperature: 0.3,
    });

    // Parse the extracted information
    const extractedContent = completion.choices[0].message.content || "";
    try {
      // Extract JSON from the response
      const jsonMatch = extractedContent.match(/```json\n([\s\S]*?)\n```/) || 
                        extractedContent.match(/{[\s\S]*?}/);
      
      if (jsonMatch) {
        return JSON.parse(jsonMatch[0]);
      } else {
        return JSON.parse(extractedContent);
      }
    } catch (error) {
      console.error("Failed to parse extracted data:", error);
      console.log("Raw extracted content:", extractedContent);
      return {};
    }
  }

  async fillRecordFields(record: EnrichRecord, missingFields: EnrichField[]): Promise<{
    updatedRecord: EnrichRecord,
    filledFields: string[]
  }> {
    try {
      if (missingFields.length === 0) {
        return { updatedRecord: record, filledFields: [] };
      }

      // Generate a search query based on the record data and missing fields
      const searchQuery = await this.generateSearchQuery(record, missingFields);
      
      // Execute the search using Tavily
      const searchResponse = await this.tavily.search(searchQuery, {
        search_depth: this.config.searchDepth,
        max_results: this.config.maxResults,
      });

      // Extract data from search results
      const extractedData = await this.extractDataFromSearchResults(
        searchResponse.results,
        record,
        missingFields
      );

      // Update the record with the extracted data
      const updatedRecord = { ...record };
      const filledFields: string[] = [];

      for (const field of missingFields) {
        if (extractedData[field.name] && extractedData[field.name] !== null) {
          const fieldIndex = updatedRecord.fields.findIndex(f => f.name === field.name);
          if (fieldIndex !== -1) {
            updatedRecord.fields[fieldIndex].value = extractedData[field.name];
            filledFields.push(field.name);
          }
        }
      }

      return { updatedRecord, filledFields };
    } catch (error) {
      console.error("Error filling record fields:", error);
      return { updatedRecord: record, filledFields: [] };
    }
  }

  async enrichData(data: EnrichData): Promise<EnrichmentResult> {
    const startTime = Date.now();
    let totalFields = 0;
    let filledFields = 0;

    console.log(`Starting data enrichment for ${data.records.length} records`);

    for (let pass = 0; pass < this.config.maxPasses; pass++) {
      console.log(`\nPass ${pass + 1}/${this.config.maxPasses}`);
      let passFilledFields = 0;

      // Process records in batches
      for (let batchIndex = 0; batchIndex < data.records.length; batchIndex += this.config.batchSize) {
        const batchEnd = Math.min(batchIndex + this.config.batchSize, data.records.length);
        console.log(`Processing batch: records ${batchIndex + 1} to ${batchEnd}`);
        
        const batchPromises = [];
        for (let recordIndex = batchIndex; recordIndex < batchEnd; recordIndex++) {
          batchPromises.push(this.processRecord(data.records, recordIndex, pass));
        }
        
        const batchResults = await Promise.all(batchPromises);
        passFilledFields += batchResults.reduce((sum, result) => sum + result, 0);
        
        // Optional delay between batches
        if (batchEnd < data.records.length) {
          await new Promise(resolve => setTimeout(resolve, 1000));
        }
      }

      filledFields += passFilledFields;
      console.log(`Pass ${pass + 1} completed: Filled ${passFilledFields} fields`);

      // If no fields were filled in this pass, we can stop early
      if (passFilledFields === 0) {
        console.log("No more fields filled, stopping early");
        break;
      }
    }

    // Count total fields (including those already filled)
    totalFields = data.records.reduce((sum, record) => sum + record.fields.length, 0);

    const endTime = Date.now();
    return {
      sourceId: data.records[0]?.tableName || "unknown",
      totalFields,
      filledFields,
      timeTaken: (endTime - startTime) / 1000
    };
  }

  private async processRecord(records: EnrichRecord[], recordIndex: number, pass: number): Promise<number> {
    const record = records[recordIndex];
    
    // Find fields with missing values
    const missingFields = record.fields.filter(field => 
      (field.value === null || field.value === undefined || field.value === '') && 
      !field.name.includes('photo') && 
      !field.name.includes('image') && 
      !field.name.includes('file')
    );
    
    if (missingFields.length === 0) {
      return 0;
    }

    // Process a subset of missing fields per pass
    const fieldsToProcess = missingFields.slice(0, this.config.maxColsPerPass);
    
    console.log(`Record ${recordIndex + 1} (${record.tableName || 'unknown'}): Attempting to fill fields: ${fieldsToProcess.map(f => f.name).join(', ')}`);
    
    // Fill in the record
    const { updatedRecord, filledFields } = await this.fillRecordFields(record, fieldsToProcess);
    
    // Update the original record
    records[recordIndex] = updatedRecord;
    
    if (filledFields.length > 0) {
      console.log(`Record ${recordIndex + 1}: Filled ${filledFields.length} fields: ${filledFields.join(', ')}`);
    } else {
      console.log(`Record ${recordIndex + 1}: No fields filled`);
    }

    return filledFields.length;
  }
}
