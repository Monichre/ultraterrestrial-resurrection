## Feature/Service Structure

Let's start by expanding our project structure to accommodate both CSV and Xata schema enrichment:

```bash
src/
├── config.ts                  # Configuration settings
├── types/
│   ├── common.ts              # Shared type definitions
│   ├── csv.ts                 # CSV-specific types
│   └── xata.ts                # Xata schema types
├── agents/
│   ├── dataAgent.ts           # Handles data loading/saving
│   ├── enrichAgent.ts         # Core enrichment logic
│   └── xataAgent.ts           # Xata-specific operations
├── enrichers/
│   ├── baseEnricher.ts        # Abstract enrichment interface
│   ├── csvEnricher.ts         # CSV-specific enrichment
│   └── xataEnricher.ts        # Xata-specific enrichment
├── utils/
│   ├── queryGenerator.ts      # Search query generation
│   └── dataExtractor.ts       # Data extraction from search results
└── index.ts                   # Main application entry point
```

## Core Types

Let's define our core types to handle both CSV and Xata data sources:

```typescript
// src/types/common.ts
export interface EnrichmentConfig {
  tavilyApiKey: string;
  openaiApiKey: string;
  maxColsPerPass: number;
  maxPasses: number;
  batchSize: number;
  searchDepth: "basic" | "advanced";
  maxResults: number;
}

export interface EnrichmentSource {
  id: string;
  type: 'csv' | 'xata';
  path?: string; // For CSV files
  tables?: string[]; // For Xata schema
}

export interface EnrichmentResult {
  sourceId: string;
  totalFields: number;
  filledFields: number;
  timeTaken: number;
}

export interface EnrichField {
  name: string;
  value: any;
  required: boolean;
}

export interface EnrichRecord {
  id: string;
  tableName?: string;
  fields: EnrichField[];
}

export interface EnrichData {
  records: EnrichRecord[];
  schema?: any;
}
```

```typescript
// src/types/xata.ts
export interface XataColumnBase {
  name: string;
  type: string;
}

export interface XataScalarColumn extends XataColumnBase {
  type: 'string' | 'text' | 'email' | 'int' | 'float' | 'datetime' | 'multiple' | 'json';
  unique?: boolean;
  defaultValue?: any;
}

export interface XataFileColumn extends XataColumnBase {
  type: 'file';
  file: {
    defaultPublicAccess: boolean;
  };
}

export interface XataFileArrayColumn extends XataColumnBase {
  type: 'file[]';
  'file[]': {
    defaultPublicAccess: boolean;
  };
}

export interface XataLinkColumn extends XataColumnBase {
  type: 'link';
  link: {
    table: string;
  };
}

export interface XataVectorColumn extends XataColumnBase {
  type: 'vector';
  vector: {
    dimension: number;
  };
}

export type XataColumn = 
  | XataScalarColumn 
  | XataFileColumn 
  | XataFileArrayColumn 
  | XataLinkColumn 
  | XataVectorColumn;

export interface XataRevLink {
  column: string;
  table: string;
}

export interface XataTable {
  name: string;
  columns: XataColumn[];
  revLinks?: XataRevLink[];
}

export interface XataSchema {
  tables: XataTable[];
}
