## CSV Enricher Implementation

```typescript
// src/enrichers/csvEnricher.ts
import * as fs from 'fs-extra';
import * as path from 'path';
import * as csv from 'csv-parser';
import { createObjectCsvWriter } from 'csv-writer';
import { BaseEnricher } from './baseEnricher';
import { EnrichmentConfig, EnrichData, EnrichField, EnrichRecord } from '../types/common';

export class CsvEnricher extends BaseEnricher {
  constructor(config: EnrichmentConfig) {
    super(config);
  }

  async loadData(filePath: string): Promise<EnrichData> {
    const records: EnrichRecord[] = [];
    const headers: string[] = [];
    
    // Create a promise to handle the async CSV parsing
    return new Promise((resolve, reject) => {
      fs.createReadStream(filePath)
        .pipe(csv())
        .on('headers', (headerList: string[]) => {
          headers.push(...headerList);
        })
        .on('data', (row: any) => {
          // Convert empty strings to null
          const fields: EnrichField[] = [];
          
          for (const key of Object.keys(row)) {
            fields.push({
              name: key,
              value: row[key] === '' ? null : row[key],
              required: false // CSV doesn't specify required fields
            });
          }
          
          records.push({
            id: `row-${records.length + 1}`,
            fields
          });
        })
        .on('end', () => {
          resolve({ records });
        })
        .on('error', (error) => {
          reject(error);
        });
    });
  }

  async saveData(data: EnrichData, outputPath: string): Promise<void> {
    // Convert EnrichData back to flat objects for CSV
    const flatRecords = data.records.map(record => {
      const flatRecord: Record<string, any> = {};
      record.fields.forEach(field => {
        flatRecord[field.name] = field.value;
      });
      return flatRecord;
    });

    // Get all unique headers
    const headers = Array.from(
      new Set(
        data.records.flatMap(record => 
          record.fields.map(field => field.name)
        )
      )
    );

    const csvWriter = createObjectCsvWriter({
      path: outputPath,
      header: headers.map(header => ({ id: header, title: header }))
    });

    await csvWriter.writeRecords(flatRecords);
    console.log(`Data saved to ${outputPath}`);
  }
}
```

## Xata Schema Enricher Implementation

```typescript
// src/enrichers/xataEnricher.ts
import { BaseEnricher } from './baseEnricher';
import { EnrichmentConfig, EnrichData, EnrichField, EnrichRecord } from '../types/common';
import { XataSchema, XataTable, XataColumn } from '../types/xata';
import { ENRICHABLE_TYPES, XATA_ENRICHABLE_TABLES } from '../config';
import * as fs from 'fs-extra';

export class XataEnricher extends BaseEnricher {
  private schema: XataSchema;
  
  constructor(config: EnrichmentConfig) {
    super(config);
    this.schema = { tables: [] };
  }

  async loadSchema(schemaPath: string): Promise<XataSchema> {
    try {
      const schemaContent = await fs.readFile(schemaPath, 'utf-8');
      this.schema = JSON.parse(schemaContent);
      return this.schema;
    } catch (error) {
      console.error("Error loading Xata schema:", error);
      throw error;
    }
  }

  isEnrichableField(column: XataColumn): boolean {
    return ENRICHABLE_TYPES.includes(column.type);
  }

  isEnrichableTable(tableName: string): boolean {
    return XATA_ENRICHABLE_TABLES.includes(tableName);
  }

  /**
   * Load mock data for Xata tables to demonstrate enrichment
   * In a real application, this would fetch actual records from Xata
   */
  async loadData(options: { schema: XataSchema, mockDataSize?: number }): Promise<EnrichData> {
    const { schema, mockDataSize = 3 } = options;
    const records: EnrichRecord[] = [];
    
    // Process only enrichable tables
    const enrichableTables = schema.tables.filter(table => 
      this.isEnrichableTable(table.name)
    );
    
    for (const table of enrichableTables) {
      const enrichableColumns = table.columns.filter(column => 
        this.isEnrichableField(column)
      );
      
      // Create mock records for this table
      for (let i = 0; i < mockDataSize; i++) {
        const fields: EnrichField[] = [];
        
        // Add fields for each enrichable column
        for (const column of enrichableColumns) {
          // For demonstration, set half the fields to null to simulate missing data
          const hasValue = Math.random() > 0.5;
          
          fields.push({
            name: column.name,
            value: hasValue ? this.generateMockValue(column) : null,
            required: false // In production, this would come from Xata schema
          });
        }
        
        records.push({
          id: `${table.name}-${i + 1}`,
          tableName: table.name,
          fields
        });
      }
    }
    
    return { records, schema };
  }

  /**
   * Generate mock values for demonstration
   * In a real application, this would be real data from Xata
   */
  private generateMockValue(column: XataColumn): any {
    switch (column.type) {
      case 'string':
        return `Sample ${column.name}`;
      case 'text':
        return `This is a sample ${column.name} with multiple sentences. It provides context for enrichment.`;
      case 'int':
        return Math.floor(Math.random() * 100);
      case 'float':
        return Math.random() * 100;
      case 'datetime':
        return new Date().toISOString();
      default:
        return null;
    }
  }

  /**
   * In a real application, this would update records in Xata
   */
  async saveData(data: EnrichData, options: { outputPath?: string }): Promise<void> {
    const { outputPath } = options;
    
    if (outputPath) {
      // Save as JSON for demonstration
      await fs.writeFile(
        outputPath,
        JSON.stringify(data.records, null, 2),
        'utf-8'
      );
      console.log(`Enriched Xata data saved to ${outputPath}`);
    } else {
      // In a real application, this would update Xata records
      console.log('Enriched data ready for updating Xata records');
      console.log(`Would update ${data.records.length} records across ${new Set(data.records.map(r => r.tableName)).size} tables`);
    }
  }
}
```

## Main Application

```typescript
// src/index.ts
import * as path from 'path';
import { config } from './config';
import { CsvEnricher } from './enrichers/csvEnricher';
import { XataEnricher } from './enrichers/xataEnricher';

async function enrichCsvData(inputPath: string, outputPath?: string) {
  try {
    const csvEnricher = new CsvEnricher(config);
    
    console.log(`Loading CSV data from ${inputPath}...`);
    const data = await csvEnricher.loadData(inputPath);
    
    console.log(`Loaded ${data.records.length} records`);
    
    // Display dataset statistics
    const totalFields = data.records.reduce((sum, record) => sum + record.fields.length, 0);
    const emptyFields = data.records.reduce((sum, record) => {
      return sum + record.fields.filter(field => 
        field.value === null || field.value === undefined || field.value === ''
      ).length;
    }, 0);
    
    console.log(`\nDataset Statistics:`);
    console.log(`Total fields: ${totalFields}`);
    console.log(`Empty fields: ${emptyFields} (${(emptyFields / totalFields * 100).toFixed(2)}%)`);
    
    // Enrich data
    console.log('\nEnriching CSV data...');
    const enrichmentResult = await csvEnricher.enrichData(data);
    
    // Calculate post-enrichment statistics
    const remainingEmptyFields = data.records.reduce((sum, record) => {
      return sum + record.fields.filter(field => 
        field.value === null || field.value === undefined || field.value === ''
      ).length;
    }, 0);
    
    console.log('\nEnrichment Results:');
    console.log(`Empty fields remaining: ${remainingEmptyFields} (${(remainingEmptyFields / totalFields * 100).toFixed(2)}%)`);
    console.log(`Fields filled: ${emptyFields - remainingEmptyFields}`);
    console.log(`Time taken: ${enrichmentResult.timeTaken.toFixed(2)} seconds`);
    
    // Save enriched data
    const effectiveOutputPath = outputPath || path.join(
      path.dirname(inputPath),
      `${path.basename(inputPath, '.csv')}_enriched.csv`
    );
    
    console.log(`\nSaving enriched CSV data to ${effectiveOutputPath}...`);
    await csvEnricher.saveData(data, effectiveOutputPath);
    
    console.log('\nCSV data enrichment completed successfully!');
    return enrichmentResult;
  } catch (error) {
    console.error('Error in CSV data enrichment process:', error);
    throw error;
  }
}

