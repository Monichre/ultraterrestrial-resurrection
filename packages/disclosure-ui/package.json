{
  "name": "@repo/disclosure-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Ultraterrestrial disclosure design system — tokens, components, style guide, and image gallery for internal apps",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./tokens": {
      "import": "./src/tokens/index.ts",
      "types": "./src/tokens/index.ts"
    },
    "./components": {
      "import": "./src/components/index.ts",
      "types": "./src/components/index.ts"
    },
    "./style-guide": {
      "import": "./src/style-guide/index.ts",
      "types": "./src/style-guide/index.ts"
    },
    "./gallery": {
      "import": "./src/gallery/index.ts",
      "types": "./src/gallery/index.ts"
    },
    "./styles/tokens.css": "./styles/tokens.css",
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "validate:tokens": "python3 scripts/validate_tokens.py styles --fix-suggestions",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "clsx": "^2.0.0",
    "lucide-react": "^0.544.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/addon-themes": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^9.1.20",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.2",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  }
}