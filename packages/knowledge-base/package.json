{
  "name": "@knowledge-base",
  "version": "0.1.0",
  "description": "Shared knowledge base for UFO/UAP data across applications",
  "main": "./index.ts",
  "module": "./index.ts",
  "types": "./index.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./index.ts",
      "types": "./index.ts"
    },
    "./case_files": "./case_files",
    "./transcripts": "./transcripts",
    "./external_resources.json": "./external_resources.json",
    "./python": "./python"
  },
  "files": [
    "index.ts",
    "external_resources.json",
    "case_files",
    "transcripts",
    "vector_storage",
    "python"
  ],
  "scripts": {
    "build": "tsc",
    "merge-knowledge": "node scripts/merge-knowledge.js"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  }
}