{
  "name": "@db",
  "version": "0.1.0",
  "description": "Database abstraction layer for Ultraterrestrial Resurrection - UFO/UAP research platform with Xata integration, vector search, and comprehensive type safety",
  "license": "MIT",
  "author": "Ultraterrestrial Resurrection Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/liamellis/ultraterrestrial-resurrection.git",
    "directory": "packages/db"
  },
  "keywords": [
    "database",
    "xata",
    "typescript",
    "ufo",
    "uap",
    "research",
    "vector-search",
    "geospatial",
    "sdk"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js", 
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./registry": {
      "import": "./dist/registry.js",
      "types": "./dist/registry.d.ts"
    },
    "./xata": {
      "import": "./dist/src/xata-typescript-sdk/index.js",
      "types": "./dist/src/xata-typescript-sdk/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js", 
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "types",
    "index.ts",
    "registry.ts",
    "*.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "bun run --watch index.ts",
    "test": "bun test",
    "test:db": "bun run test-db-connection.js",
    "seed": "bun run xata-seeding-script.ts",
    "seed:simple": "bun run simple-seed.js",
    "seed:python": "python simple-seed.py",
    "fix-and-seed": "bun run fix-and-seed.ts",
    "analyze": "bun run database-state-analysis.js",
    "query": "bun run quick-db-query.ts",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit --strict",
    "clean": "rm -rf dist node_modules/.cache"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@xata.io/client": "^0.30.1", 
    "xata": "^0.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  }
}