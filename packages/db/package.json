{
  "name": "@db",
  "version": "0.1.0",
  "description": "Database abstraction layer for Ultraterrestrial Resurrection - UFO/UAP research platform with Xata integration, vector search, and comprehensive type safety",
  "license": "MIT",
  "author": "Ultraterrestrial Resurrection Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/liamellis/ultraterrestrial-resurrection.git",
    "directory": "packages/db"
  },
  "keywords": [
    "database",
    "xata",
    "typescript",
    "ufo",
    "uap",
    "research",
    "vector-search",
    "geospatial",
    "sdk"
  ],
  "main": "index.ts",
  "module": "index.ts",
  "types": "index.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./index.ts",
      "types": "./index.ts"
    },
    "./postgres": {
      "import": "./src/postgres/index.ts",
      "types": "./src/postgres/index.ts"
    },
    "./registry": {
      "import": "./registry.ts",
      "types": "./registry.ts"
    },
    "./xata": {
      "import": "./src/xata-typescript-sdk/index.ts",
      "types": "./src/xata-typescript-sdk/index.ts"
    },
    "./xata/*": {
      "import": "./src/xata-typescript-sdk/*.ts",
      "types": "./src/xata-typescript-sdk/*.ts"
    },
    "./xata/client": {
      "import": "./src/xata-typescript-sdk/client.ts",
      "types": "./src/xata-typescript-sdk/client.ts"
    },
    "./xata/xata": {
      "import": "./src/xata-typescript-sdk/xata.ts",
      "types": "./src/xata-typescript-sdk/xata.ts"
    },
    "./xata/models": {
      "import": "./src/xata-typescript-sdk/models/index.ts",
      "types": "./src/xata-typescript-sdk/models/index.ts"
    },
    "./xata/models/*": {
      "import": "./src/xata-typescript-sdk/models/*.ts",
      "types": "./src/xata-typescript-sdk/models/*.ts"
    },
    "./xata/api": {
      "import": "./src/xata-typescript-sdk/api/index.ts",
      "types": "./src/xata-typescript-sdk/api/index.ts"
    },
    "./xata/api/*": {
      "import": "./src/xata-typescript-sdk/api/*.ts",
      "types": "./src/xata-typescript-sdk/api/*.ts"
    },
    "./src/xata-typescript-sdk/api": {
      "import": "./src/xata-typescript-sdk/api/index.ts",
      "types": "./src/xata-typescript-sdk/api/index.ts"
    },
    "./types": {
      "import": "./types/index.ts",
      "types": "./types/index.ts"
    },
    "./commands": {
      "import": "./commands/index.ts",
      "types": "./commands/index.ts"
    },
    "./commands/*": {
      "import": "./commands/*.ts",
      "types": "./commands/*.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "types",
    "index.ts",
    "registry.ts",
    "*.md"
  ],
  "scripts": {
    "dev": "bun run --watch index.ts",
    "test": "bun test",
    "test:db": "bun run test-db-connection.js",
    "seed": "bun run xata-seeding-script.ts",
    "seed:simple": "bun run simple-seed.js",
    "seed:python": "python simple-seed.py",
    "fix-and-seed": "bun run fix-and-seed.ts",
    "analyze": "bun run database-state-analysis.js",
    "query": "bun run quick-db-query.ts",
    "type-check": "tsc --noEmit --skipLibCheck",
    "clean": "rm -rf node_modules/.cache",
    "smoke-test": "bun run run-smoke-tests.ts",
    "interactive": "bun run interactive-cli.ts",
    "cmd:demo": "bun run demo-xata-commands.ts",
    "cmd:create": "bun run -e 'import {executeXataCommand} from \"./commands/index.ts\"; executeXataCommand(JSON.parse(process.argv[2])).then(console.log)'",
    "cmd:read": "bun run -e 'import {executeXataCommand} from \"./commands/index.ts\"; executeXataCommand(JSON.parse(process.argv[2])).then(console.log)'",
    "cmd:update": "bun run -e 'import {executeXataCommand} from \"./commands/index.ts\"; executeXataCommand(JSON.parse(process.argv[2])).then(console.log)'",
    "cmd:delete": "bun run -e 'import {executeXataCommand} from \"./commands/index.ts\"; executeXataCommand(JSON.parse(process.argv[2])).then(console.log)'",
    "enhanced-cli": "bun run enhanced-cli-commands.ts",
    "enhanced-demo": "bun run enhanced-demo.ts",
    "cmd:ask": "bun run -e 'import {askXata} from \"./src/xata-typescript-sdk/api/ask.ts\"; askXata(process.argv[2], process.argv.slice(3).join(\" \")).then(console.log)'",
    "cmd:search": "bun run -e 'import {searchXata} from \"./src/xata-typescript-sdk/api/search.ts\"; searchXata({query: process.argv.slice(2).join(\" \")}).then(console.log)'",
    "cmd:aggregate": "bun run -e 'import(\"./enhanced-cli-commands.ts\").then(m => m.handleAggregateCommand(process.argv[2], process.argv[3]))'",
    "cmd:ufo-credibility": "bun run enhanced-cli-commands.ts ufo-credibility",
    "cmd:ufo-disclosure": "bun run enhanced-cli-commands.ts ufo-disclosure",
    "cmd:ufo-timeline": "bun run enhanced-cli-commands.ts ufo-timeline",
    "cmd:ufo-geographic": "bun run enhanced-cli-commands.ts ufo-geographic",
    "cmd:multi-table": "bun run enhanced-cli-commands.ts multi-table"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.0.13",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@xata.io/client": "^0.30.1",
    "xata": "^0.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  }
}