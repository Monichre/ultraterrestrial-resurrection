{
  "name": "@repo/ai",
  "version": "0.1.0",
  "private": true,
  "description": "Ultraterrestrial AI workspace — agent suite grammar, prompt registry (@repo/prompts), and vendor research service adapters",
  "type": "module",
  "exports": {
    ".": {
      "import": "./services/index.ts",
      "types": "./services/index.ts"
    },
    "./services": {
      "import": "./services/index.ts",
      "types": "./services/index.ts"
    },
    "./services/*": "./services/*"
  },
  "scripts": {
    "build": "tsup services/index.ts --format esm,cjs --dts",
    "dev": "tsup services/index.ts --format esm,cjs --watch --dts",
    "clean": "rm -rf dist",
    "lint": "eslint services --ext .ts"
  },
  "dependencies": {
    "@mendable/firecrawl-js": "^1.0.0",
    "exa-js": "^1.0.0",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.22.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "eslint": "^8.56.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  }
}