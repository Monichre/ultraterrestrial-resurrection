{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Prompt YAML Schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "runtime": {
      "type": "object",
      "properties": {
        "max_tokens": {
          "type": "number"
        },
        "temperature": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "type"
        ]
      }
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "version",
    "prompt"
  ],
  "additionalProperties": true
}