{
  "name": "@ultraterrestrial/services",
  "version": "0.1.0",
  "description": "Integrated services for Ultraterrestrial project including Firecrawl and Exa AI",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup index.ts --format cjs,esm --dts",
    "dev": "tsup index.ts --format cjs,esm --watch --dts",
    "clean": "rm -rf dist",
    "lint": "eslint *.ts **/*.ts"
  },
  "dependencies": {
    "@mendable/firecrawl-js": "^1.0.0",
    "exa-js": "^1.0.0",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.22.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "eslint": "^8.56.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  }
}