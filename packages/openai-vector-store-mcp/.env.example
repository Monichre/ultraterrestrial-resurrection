# OpenAI Vector Store MCP
OPENAI_API_KEY=sk-proj-your_openai_api_key

# Prefer VECTOR_STORE_ID; OPENAI_VECTOR_STORE_ID is accepted as a fallback
# (matches apps/app Prometheus / disclosure vector store env naming).
VECTOR_STORE_ID=vs_your_openai_vector_store_id
# OPENAI_VECTOR_STORE_ID=vs_your_openai_vector_store_id

# stdio (Cursor / local) | sse (ChatGPT remote / OpenAI API example) | http
MCP_TRANSPORT=stdio

# Used when MCP_TRANSPORT is sse or http
MCP_HOST=0.0.0.0
MCP_PORT=8000
