# .env.example
# Copy this file to .env.local and fill in the values.
# Never commit real secrets to source control.
#
# 212+ variables across many services. See docs/CONTRIB.md for details.
# Minimum viable set for local AI dev:
#   XATA_API_KEY, XATA_BRANCH, XATA_DATABASE_URL
#   OPENAI_API_KEY, OPENAI_ASSISTANT_ID, OPENAI_VECTOR_STORE_ID
#   DISCLOSURE_ENGINEER_ASSISTANT_ID, DISCLOSURE_ENGINEER_VECTOR_STORE_ID
#   CLERK_SECRET_KEY, NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY

# ==============================================================================
# APP / ENVIRONMENT
# ==============================================================================

# Runtime environment (local | preview | production)
NEXT_PUBLIC_APP_ENV=local

# ==============================================================================
# TIPTAP (Research Editor)
# Pro extensions, AI, and document server credentials from https://tiptap.dev
# ==============================================================================

TIP_TAP_PRO_TOKEN=YOUR_TIPTAP_PRO_TOKEN
TIPTAP_AI_APP_ID=YOUR_TIPTAP_AI_APP_ID
TIPTAP_AI_SECRET=YOUR_TIPTAP_AI_SECRET
TIPTAP_CONVERSION_APP_ID=YOUR_TIPTAP_CONVERSION_APP_ID
TIPTAP_CONVERSION_SECRET=YOUR_TIPTAP_CONVERSION_SECRET
TIPTAP_DOCUMENT_SERVER_ID=YOUR_TIPTAP_DOCUMENT_SERVER_ID
TIPTAP_APP_ID=YOUR_TIPTAP_APP_ID
TIPTAP_APP_SECRET=YOUR_TIPTAP_APP_SECRET
TIPTAP_DOCUMENT_MANAGEMENT_APP_SECRET=YOUR_TIPTAP_DOCUMENT_MANAGEMENT_APP_SECRET

# Cult UI Pro (Tiptap-adjacent component kit)
CULT_PRO_TOKEN=YOUR_CULT_PRO_TOKEN

# ==============================================================================
# SANITY (CMS)
# https://sanity.io — content management project credentials
# ==============================================================================

NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# ==============================================================================
# SUPABASE (Secondary Database / Storage)
# https://supabase.com — not the primary DB (Xata is), but used for storage
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PROJECT_ID=your-supabase-project-id
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_CONNECTION_STRING=postgresql://postgres:YOUR_PASSWORD@db.your-project.supabase.co:5432/postgres

# Supabase S3-compatible storage bucket
STORAGE_BUCKET_URL=https://your-project.supabase.co/storage/v1/s3
ACCESS_KEY_ID=your-supabase-storage-access-key-id
SECRET_ACCESS_KEY=your-supabase-storage-secret-access-key

# ==============================================================================
# INSTAGRAM / META
# https://developers.facebook.com — Instagram Graph API and Meta App credentials
# ==============================================================================

INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
INSTAGRAM_USER_TOKEN=your-instagram-user-access-token

META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# ==============================================================================
# AIRTABLE
# https://airtable.com — spreadsheet-style data collaboration
# ==============================================================================

AIRTABLE_BASE=your-airtable-base-id
AIRTABLE_ACCESS_TOKEN=your-airtable-personal-access-token

# ==============================================================================
# DISCLOSURE ENGINEER (OpenAI Assistants — Mindmap AI Agent)
# The primary working AI agent for the research canvas.
# Create in https://platform.openai.com/assistants
# ==============================================================================

DISCLOSURE_ENGINEER_ASSISTANT_ID=asst_your_disclosure_engineer_assistant_id
DISCLOSURE_ENGINEER_VECTOR_STORE_ID=vs_your_disclosure_engineer_vector_store_id

# ==============================================================================
# GOOGLE
# https://console.cloud.google.com — Google Cloud / Gemini API access
# ==============================================================================

GOOGLE_API_KEY=your-google-api-key
GEMINI_API_KEY=your-gemini-api-key

# ==============================================================================
# XATA (Primary Database)
# https://xata.io — PostgreSQL-powered database with full-text search.
# 230,998+ UAP/disclosure records. REQUIRED for all DB operations.
# ==============================================================================

XATA_DATABASE_URL=https://your-workspace.us-east-1.xata.sh/db/your-database
XATA_API_KEY=xau_your_xata_api_key
XATA_BRANCH=main

# ==============================================================================
# NEO4J (Graph Database)
# https://neo4j.com — graph database for relationship traversal
# ==============================================================================

NEO_USERNAME=neo4j
NEO_PASSWORD=your-neo4j-password
NEO4J_API_KEY=your-neo4j-api-key

# ==============================================================================
# MAPBOX (Globe / Sightings Visualization)
# https://mapbox.com — maps and geospatial visualization for UAP sightings globe
# ==============================================================================

NEXT_PUBLIC_MAPBOX_PUBLIC_TOKEN=pk.your_mapbox_public_token
NEXT_PUBLIC_TILE_SET_ID=your-username.your-tileset-id
NEXT_PUBLIC_DATA_SET_ID=your-mapbox-dataset-id
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/your-username/your-style-id

# RapidAPI (used by Mapbox-adjacent features)
NEXT_PUBLIC_RAPID_API_KEY=your-rapidapi-key

# ==============================================================================
# TWITTER / X
# https://developer.twitter.com — social media integration
# ==============================================================================

TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret
TWITTER_API_BEARER_TOKEN=your-twitter-bearer-token
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret

# ==============================================================================
# CLERK (Authentication)
# https://clerk.com — user authentication and session management.
# REQUIRED — middleware gates routes. Get keys from Clerk dashboard.
# ==============================================================================

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_clerk_webhook_signing_secret

# GitHub OAuth via Clerk
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# Clerk redirect URLs (these values are standard and usually unchanged)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ==============================================================================
# NOTION
# https://notion.so — documentation and knowledge base integration
# ==============================================================================

NOTION_TOKEN=your-notion-integration-token
NOTION_API_KEY=your-notion-api-key

# ==============================================================================
# HYGRAPH (Headless CMS)
# https://hygraph.com — GraphQL CMS for structured content
# ==============================================================================

HYPGRAPH_MANAGEMENT_TOKEN=your-hygraph-management-token
HYGRAPH_PROJECT_ID=your-hygraph-project-id
HYGRAPH_CONTENT_API_ENDPOINT=https://us-east-1-shared-usea1-02.cdn.hygraph.com/content/your-project-id/master
HYGRAPH_MANAGEMENT_GRAPHQL_ENDPOINT=https://management-us-east-1-shared-usea1-02.hygraph.com/graphql

# ==============================================================================
# BROWSERBASE
# https://browserbase.com — cloud browser automation
# ==============================================================================

BROWSERBASE_PROJECT_ID=your-browserbase-project-id
BROWSERBASE_API_KEY=your-browserbase-api-key

# ==============================================================================
# BASEHUB (Content API)
# https://basehub.com — developer-friendly CMS
# ==============================================================================

BASEHUB_ADMIN_TOKEN=bshb_pk_your_basehub_admin_token
BASEHUB_API_ENDPOINT=https://api.basehub.com/graphql
BASEHUB_TOKEN=bshb_pk_your_basehub_token

# ==============================================================================
# COPILOT CLOUD (Assistant UI)
# https://cloud.assistant-ui.com — hosted chat history / assistant backend
# ==============================================================================

NEXT_PUBLIC_COPILOT_CLOUD_API_KEY=ck_pub_your_copilot_cloud_api_key
NEXT_PUBLIC_ASSISTANT_API_URL=https://your-project.assistant-api.com
NEXT_PUBLIC_ASSISTANT_PROJECT_SLUG=cloud.assistant-ui.com/your-org/your-project
CLOUD_ASSISTANT_API_KEY=sk_aui_proj_your_key

# ==============================================================================
# EXA (External Research Search)
# https://exa.ai — semantic web search used by the disclosure mindmap agent
# ==============================================================================

EXA_API_KEY=your-exa-api-key

# ==============================================================================
# LANGCHAIN / LANGSMITH (AI Tracing & Orchestration)
# https://smith.langchain.com — tracing and observability for LLM chains
# ==============================================================================

LANGCHAIN_API_KEY=lsv2_pt_your_langchain_api_key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=your-langchain-project-name

# ==============================================================================
# JINA AI (Document Processing / Reader)
# https://jina.ai — document embedding and reader API
# ==============================================================================

JINA_API_KEY=your-jina-api-key

# ==============================================================================
# LANGBASE (AI Pipe Infrastructure)
# https://langbase.com — AI pipe routing and management
# ==============================================================================

LANGBASE_API_KEY=your-langbase-api-key
LANGBASE_PIPE_BASE_URL=https://api.langbase.com/beta/pipes/run
LANGBASE_UT_LEAD_ENGINEER_PIPE_KEY=pipe_your_lead_engineer_pipe_key
LANGBASE_UT_DB_ENGINEER_PIPE_KEY=pipe_your_db_engineer_pipe_key
LANGBASE_UT_REACT_DEV_PIPE_KEY=pipe_your_react_dev_pipe_key

# ==============================================================================
# TOGETHER AI
# https://together.ai — fast open-source model inference
# ==============================================================================

TOGETHER_API_KEY=your-together-ai-api-key
TOGETHERAI_API_KEY=your-together-ai-api-key

# ==============================================================================
# COHERE
# https://cohere.com — NLP and reranking models
# ==============================================================================

COHERE_API_KEY=your-cohere-api-key

# ==============================================================================
# INGEST (Event Ingestion)
# Signing key for inbound webhook/event verification
# ==============================================================================

INGEST_API_KEY=your-ingest-signing-key

# ==============================================================================
# LIVEBLOCKS (Real-time Collaboration)
# https://liveblocks.io — presence, cursors, and collaborative features
# ==============================================================================

LIVEBLOCKS_API_KEY=pk_dev_your_liveblocks_public_key
LIVEBLOCKS_SECRET_KEY=sk_dev_your_liveblocks_secret_key
LIVEBLOCKS_PROJECT_ID=your-liveblocks-project-id

# ==============================================================================
# NGROK (Local Tunnel)
# https://ngrok.com — expose local dev server to the internet for webhooks
# ==============================================================================

NGROK_AUTH_TOKEN=your-ngrok-auth-token

# ==============================================================================
# TRIGGER.DEV (Background Jobs)
# https://trigger.dev — background task and job queue runner
# ==============================================================================

TRIGGER_API_KEY=tr_dev_your_trigger_api_key

# ==============================================================================
# UPSTASH REDIS
# https://upstash.com — serverless Redis for caching and rate limiting
# ==============================================================================

UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# ==============================================================================
# UPSTASH QSTASH (Message Queue)
# https://upstash.com/qstash — HTTP-based serverless message queue
# ==============================================================================

# Required for sending messages
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=your-qstash-token

# Required for receiving / verifying messages
QSTASH_CURRENT_SIGNING_KEY=sig_your_current_signing_key
QSTASH_NEXT_SIGNING_KEY=sig_your_next_signing_key

# ==============================================================================
# UPSTASH VECTOR
# https://upstash.com/vector — serverless vector database (not yet wired to Next.js app)
# ==============================================================================

UPSTASH_VECTOR_REST_URL=https://your-vector-instance.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your-upstash-vector-rest-token

# ==============================================================================
# UPSTASH SEARCH (Document Library)
# https://upstash.com — full-text search service
# ==============================================================================

UPSTASH_SEARCH_REST_URL=https://your-search-instance.upstash.io
UPSTASH_SEARCH_REST_TOKEN=your-upstash-search-rest-token

# ==============================================================================
# NEON (Serverless PostgreSQL — Secondary)
# https://neon.tech — not the primary DB but available for other services
# ==============================================================================

NEON_DATABASE_URL=postgresql://your_user:your_password@your-host.neon.tech/your_db?sslmode=require
NEON_ROLE_PW=your-neon-role-password

# ==============================================================================
# RAILWAY (Hosted Services)
# https://railway.app — hosting for Postgres, Directus, and other services
# ==============================================================================

RAILWAY_PROJECT_ID=your-railway-project-id
RAILWAY_TOKEN=your-railway-api-token
RAILWAY_DATABASE_PRIVATE_URL=postgres://railway:YOUR_PASSWORD@postgres.railway.internal:5432/railway
RAILWAY_DATABASE_URL=postgres://railway:YOUR_PASSWORD@your-host.railway.app:PORT/railway
RAILWAY_PG_DATA=/var/lib/postgresql/data/pgdata
RAILWAY_DIRECTUS_DATABASE_PRIVATE_URL=postgres://railway:YOUR_PASSWORD@postgres.railway.internal:5432/railway
RAILWAY_DIRECTUS_DATABASE_URL=postgres://railway:YOUR_PASSWORD@your-host.railway.app:PORT/railway
RAILWAY_DATABASE_PASSWORD=your-railway-database-password

# ==============================================================================
# CONVEX (Realtime Backend)
# https://convex.dev — reactive backend with real-time sync
# ==============================================================================

CONVEX_HTTP_ACTIONS_URL=https://your-project.convex.site
CONVEX_DEPLOYMENT_URL=https://your-project.convex.cloud
# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-project-name
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud

# ==============================================================================
# NUCLIA (Knowledge Base / Neural Search)
# https://nuclia.com — AI-powered knowledge base search
# ==============================================================================

NUCLIA_API_KEY=your-nuclia-api-key
NUCLIA_DB_API_ENDPOINT=https://aws-us-east-2-1.nuclia.cloud/api/v1/kb/your-knowledge-box-id
NUCLIA_KNOWLEDGE_BOX_ID=your-nuclia-knowledge-box-id

# ==============================================================================
# MATERIALIZE (Streaming SQL)
# https://materialize.com — real-time data warehouse
# ==============================================================================

MATERIALIZE_HOST_URL=your-cluster.lb.us-east-1.aws.materialize.cloud
MATERIALIZE_PORT=6875
MATERIALIZE_USER=your-materialize-user@example.com
MATERIALIZE_PASSWORD=mzp_your_materialize_password
MATERIALIZE_WEBHOOK_URL=https://your-cluster.lb.us-east-1.aws.materialize.cloud/api/webhook/materialize/public/your-worker

# ==============================================================================
# CARTESIAN (Geospatial / Analytics)
# ==============================================================================

CARTESIAN_API_KEY=your-cartesian-api-key

# ==============================================================================
# CLOUDFLARE
# https://cloudflare.com — CDN, Workers, and account-level operations
# ==============================================================================

CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# ==============================================================================
# PAYLOAD CMS (PostgreSQL-backed CMS)
# https://payloadcms.com — headless CMS with Railway-hosted Postgres
# ==============================================================================

PAYLOAD_CMS_POSTGRES_DB_PSQL=PGPASSWORD=your_password psql -h your-host -U postgres -p PORT -d railway
PAYLOAD_CMS_POSTGRES_URL=postgresql://postgres:YOUR_PASSWORD@your-host:PORT/railway

# ==============================================================================
# AITABLE (Spreadsheet / DB Hybrid)
# https://aitable.ai — collaborative spreadsheet database
# ==============================================================================

AITABLE_API_KEY=your-aitable-api-key

# ==============================================================================
# TAVILY (AI Search)
# https://tavily.com — AI-powered research search API
# ==============================================================================

TAVILY_API_KEY=tvly-your_tavily_api_key

# ==============================================================================
# ANTHROPIC (Claude AI)
# https://anthropic.com — Claude models used in Prometheus chat route
# ==============================================================================

ANTHROPIC_API_KEY=sk-ant-api03-your_anthropic_api_key

# ==============================================================================
# OPENAI
# https://platform.openai.com — primary AI provider.
# REQUIRED for the disclosure mindmap agent (Assistants API + file_search).
# ==============================================================================

OPENAI_API_KEY=sk-proj-your_openai_api_key
# OpenAI Assistant ID for the mindmap agent (Party Martian / main assistant)
OPENAI_ASSISTANT_ID=asst_your_openai_assistant_id
# OpenAI Vector Store ID for UAP research data
OPENAI_VECTOR_STORE_ID=vs_your_openai_vector_store_id

# ==============================================================================
# GROQ (Fast Inference)
# https://console.groq.com — fast open-source model inference
# ==============================================================================

GROQ_API_KEY=gsk_your_groq_api_key

# ==============================================================================
# DEEPGRAM (Speech-to-Text)
# https://deepgram.com — audio transcription
# ==============================================================================

DEEPGRAM_API_KEY=your-deepgram-api-key

# ==============================================================================
# SERPER (Google Search API)
# https://serper.dev — Google Search results via API
# ==============================================================================

SERPER_API_KEY=your-serper-api-key

# ==============================================================================
# MEM0 (AI Memory Layer)
# https://mem0.ai — persistent memory for AI agents
# ==============================================================================

NEXT_PUBLIC_MEM0_API_KEY=m0-your_mem0_api_key
MEM0_API_KEY=m0-your_mem0_api_key

# ==============================================================================
# E2B (Code Execution Sandbox)
# https://e2b.dev — secure cloud sandboxes for AI code execution
# ==============================================================================

E2B_API_KEY=e2b_your_e2b_api_key

# ==============================================================================
# FIRECRAWL (Web Scraping / Crawling)
# https://firecrawl.dev — structured web scraping and crawling pipeline
# ==============================================================================

FIRECRAWL_API_KEY=fc-your_firecrawl_api_key
NEXT_PUBLIC_FIRECRAWL_API_KEY=fc-your_firecrawl_api_key

# ==============================================================================
# COMPOSIO (AI Tool Integration)
# https://composio.dev — managed tool integrations for AI agents
# ==============================================================================

COMPOSIO_API_KEY=your-composio-api-key

# ==============================================================================
# MULTION AI (Browser Agent)
# https://multion.ai — AI-powered browser automation
# ==============================================================================

MULTIONAI_API_KEY=your-multionai-api-key

# ==============================================================================
# PERIGNON (Custom Service)
# ==============================================================================

PERIGNON_API_KEY=your-perignon-api-key

# ==============================================================================
# SEARCH1API
# https://search1api.com — alternative search API
# ==============================================================================

SEARCH1API_KEY=your-search1api-key

# ==============================================================================
# SCRAPEGRAPH AI (AI-powered Scraping)
# https://scrapegraphai.com — LLM-based web scraping
# ==============================================================================

SCRAPEGRAPH_API_KEY=sgai-your_scrapegraph_api_key

# ==============================================================================
# PERPLEXITY AI
# https://perplexity.ai — AI-powered search and research
# ==============================================================================

PERPLEXITY_API_KEY=pplx-your_perplexity_api_key
PERPLEXITY_MODEL=sonar-pro

# ==============================================================================
# TASK MASTER / AI AGENT DEFAULTS
# Optional configuration defaults for AI task generation
# ==============================================================================

MODEL=claude-3-7-sonnet-20250219
MAX_TOKENS=64000
TEMPERATURE=0.2
DEBUG=false
LOG_LEVEL=info
DEFAULT_SUBTASKS=5
DEFAULT_PRIORITY=medium
PROJECT_NAME=Ultraterrestrial Resurrection

# ==============================================================================
# TIMESCALE (Time-Series PostgreSQL)
# https://timescaledb.com — time-series data storage
# ==============================================================================

TIMESCALE_USERNAME=tsdbadmin
TIMESCALE_PASSWORD=your-timescale-password
TIMESCALE_DATABASE=tsdb
TIMESCALE_HOST=your-cluster.tsdb.cloud.timescale.com
TIMESCALE_PORT=36205
TIMESCALE_URL=postgres://tsdbadmin:YOUR_PASSWORD@your-cluster.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
TIMESCALE_CONNECTION_STRING=postgres://tsdbadmin:YOUR_PASSWORD@your-cluster.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
_CONNECTION_STRING=postgres://tsdbadmin:YOUR_PASSWORD@your-cluster.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require

# ==============================================================================
# VERCEL BLOB (File Storage)
# https://vercel.com/storage/blob — serverless file/image storage
# ==============================================================================

BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token
BLOB_STORE_ID=store_your_store_id
BLOB_BASE_URL=https://your-store-id.public.blob.vercel-storage.com

# ==============================================================================
# xAI / GROK
# https://x.ai — xAI Grok model API access
# ==============================================================================

XAI_API_KEY=xai-your_xai_api_key
GROK_API_KEY=xai-your_grok_api_key

# ==============================================================================
# R2R (Retrieval-Augmented Generation Infrastructure)
# https://r2r-docs.sciphi.ai — RAG framework API
# ==============================================================================

R2R_PUBLIC_KEY=pk_your_r2r_public_key
R2R_SECRET_KEY=pk_your_r2r_public_key.sk_your_r2r_secret_key

# ==============================================================================
# LLAMA INDEX
# https://llamaindex.ai — LLM data framework and indexing
# ==============================================================================

LLAMA_INDEX_API_KEY=llx-your_llama_index_api_key

# ==============================================================================
# SOURCEGRAPH
# https://sourcegraph.com — code search and intelligence
# ==============================================================================

SOURCE_GRAPH_API_KEY=sgp_your_sourcegraph_api_key

# ==============================================================================
# ARCADE AI (Tool / Function Execution)
# https://arcade-ai.com — hosted tool execution for AI agents
# ==============================================================================

ARCADE_API_KEY=arc_your_arcade_api_key

# ==============================================================================
# POSTHOG (Product Analytics)
# https://posthog.com — event tracking and product analytics
# ==============================================================================

POSTHOG_API_KEY=phx_your_posthog_api_key

# ==============================================================================
# BASEROW (Open-source Database)
# https://baserow.io — open-source Airtable alternative
# ==============================================================================

BASEROW_DATABASE_TOKEN=your-baserow-database-token

# ==============================================================================
# PORTKEY (AI Gateway / Routing)
# https://portkey.ai — AI gateway for routing, caching, and observability
# ==============================================================================

PORTKEY_API_KEY=your-portkey-api-key

# ==============================================================================
# COCOINDEX (Vector Index — Not currently wired to Next.js app)
# Experimental CocoIndex configuration
# ==============================================================================

COCOINDEX_ENABLED=false
COCOINDEX_FLOW_NAME=UFOResearch

# ==============================================================================
# RAGIE (Retrieval AI)
# https://ragie.ai — managed RAG infrastructure
# ==============================================================================

RAGIE_API_KEY=tnt_your_ragie_api_key

# ==============================================================================
# BRIGHT DATA (Web Scraping Infrastructure)
# https://brightdata.com — proxy and web scraping network
# ==============================================================================

BRIGHT_DATA_API_KEY=your-bright-data-api-key

# ==============================================================================
# ONE NODE
# Custom API service
# ==============================================================================

ONE_NODE_API_KEY=your-one-node-api-key

# ==============================================================================
# AI GATEWAY
# Internal/custom AI routing gateway
# ==============================================================================

AI_GATEWAY_API_KEY=vck_your_ai_gateway_api_key

# ==============================================================================
# HONCHO (AI Memory / Personalization)
# https://honcho.dev — user-level memory and personalization for AI apps
# ==============================================================================

HONCHO_API_KEY=hch-v2-your_honcho_api_key

# ==============================================================================
# FACTORY AI (AI Development Platform)
# https://factory.ai — AI-powered development automation
# ==============================================================================

FACTORY_AI_API_KEY=fk-your_factory_ai_api_key

# --- LLM gateways (completion fallback chain, 2026-08-07) -------------------
# Chain order: openrouter -> huggingface -> ollama-cloud -> deepseek -> ...
# First-party OPENAI/ANTHROPIC completion tiers were removed by policy; these
# three are the replacements. Tier 1 is the only one currently funded.
OPENROUTER_API_KEY=
HUGGINGFACE_ACCESS_TOKEN=
OLLAMA_API_KEY=
