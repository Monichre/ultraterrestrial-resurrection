!state.json
# Include package.json files
!package.json
!package-lock.json
# Allow tracking specific JSON configs
!apps/app/components.json
!vercel.json
!**/tsconfig.json
!**/tsconfig.*.json
# Canonical archive metadata — not a large data file, it's the source of truth
!packages/knowledge-base/metadata/index.json
!packages/knowledge-base/metadata/redirect.json
# T-061 source registry. The YouTube snapshot is PERISHABLE — videoId -> channel
# only resolves while a video is public, so this capture is not reproducible.
!packages/knowledge-base/metadata/source-registry.json
!packages/knowledge-base/metadata/tier-a-youtube-snapshot.json
!packages/knowledge-base/metadata/tier-c-youtube-snapshot.json
# The PDFs under sources/files/ are gitignored, so git holds no record of the
# T-061 taxonomy renames. This manifest (md5 + original filename for all 31) is
# the ONLY undo path — it must stay tracked.
!packages/knowledge-base/metadata/files-rename-manifest.json
!packages/knowledge-base/metadata/ocr-manifest.json
# Corpus identity index (T-061/T-059) — the pre-ingest dedupe check.
!packages/knowledge-base/metadata/corpus-manifest.json
# Sibling sha256 index for apps/disclosure-rag/corpus/intake/ (the raw intake
# dump) — split out because it runs ~14k entries; see corpus_manifest.py docstring.
!packages/knowledge-base/metadata/corpus-manifest-intake.json
!packages/knowledge-base/metadata/duplicate-report-cross-tree.json
!packages/knowledge-base/metadata/duplicate-report-intra-intake.json
!packages/knowledge-base/metadata/vector-store-gap-report.json
!packages/knowledge-base/metadata/intake-ocr-census.jsonl
!packages/knowledge-base/metadata/source-resolution.jsonl

